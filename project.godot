; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PlaytimeLauncher"
run/main_scene="uid://cxbqc6hmceq7w"
config/use_custom_user_dir=true
config/custom_user_dir_name="ParkerBett/PlaytimeLauncher"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
boot_splash/use_filter=false
config/icon="uid://cny2gvah6hyry"
config/windows_native_icon="res://assets/icons/icon.ico"

[autoload]

Global="*uid://dmj5u74sr5fm1"
Save="*uid://8irt3cl5huy1"

[display]

window/size/resizable=false
window/size/borderless=true
window/size/always_on_top=true
window/size/minimize_disabled=true
window/size/maximize_disabled=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/saltmire_save_lite/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
